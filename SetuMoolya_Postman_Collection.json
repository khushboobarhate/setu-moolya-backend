    {
      "name": "📱 OTP — Mobile Verification",
      "item": [
        {
          "name": "1. Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "var requestBody = JSON.parse(pm.request.body.raw);",
                  "pm.collectionVariables.set('otp_phone', requestBody.phone);",
                  "if (res.success && res.otp) {",
                  "    // DEV provider only: MSG91 sends its OTP by SMS.",
                  "    pm.collectionVariables.set('otp_code', res.otp);",
                  "    console.log('Development OTP captured.');",
                  "}",
                  "pm.test('OTP request is handled', function () {",
                  "    pm.expect([200, 409]).to.include(pm.response.code);",
                  "    if (pm.response.code === 200) pm.expect(res.success).to.be.true;",
                  "    if (pm.response.code === 409) pm.expect(res.message).to.include('MSG91 browser widget');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/otp/send",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "otp",
                "send"
              ]
            },
            "description": "Send an OTP using Twilio or the development provider. With `SMS_PROVIDER=msg91`, send the OTP from the MSG91 browser widget instead; this endpoint intentionally returns 409 in widget mode. After the widget verifies the code, submit its `data[\"access-token\"]` and the same phone to the Verify request. For local dev, use the `otp` returned by this request."
          },
          "response": []
        },
        {
          "name": "2. Verify OTP (Get phone_verified_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.success && res.phone_verified_token) {",
                  "    pm.collectionVariables.set('phone_verified_token', res.phone_verified_token);",
                  "    console.log('phone_verified_token saved:', res.phone_verified_token);",
                  "}",
                  "pm.test('OTP verified and token received', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.phone_verified_token).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\",\n  \"access_token\": \"<MSG91 widget data[access-token]>\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/otp/verify",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "otp",
                "verify"
              ]
            },
            "description": "With `SMS_PROVIDER=msg91`, submit the same phone used in the widget and the JWT from `data[\"access-token\"]`; the backend validates it with MSG91 before issuing `phone_verified_token`. With Twilio/dev, replace `access_token` with the numeric `otp` field. The verified registration token is saved for the registration request."
          },
          "response": []
        },
        {
          "name": "❌ Verify OTP — Wrong OTP (Error Case)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\",\n  \"access_token\": \"invalid-widget-token\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/otp/verify",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "otp",
                "verify"
              ]
            },
            "description": "Expected: 400 Bad Request — Invalid OTP."
          },
          "response": []
        }
      ]
    },

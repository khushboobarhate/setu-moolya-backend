# Server (Node.js 22+)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
CLIENT_LOGIN_URL=http://localhost:3000/login
CLIENT_RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Supabase database + Auth. All three values are required.
# Service-role key stays on the backend only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Groq API for Multilingual Farmer AI Agent, Vision, and Whisper Speech-to-Text
GROQ_API_KEY=YOUR_NEW_GROQ_API_KEY

# SMTP for admin credential emails and Forgot password.
# For Gmail, use an App Password. No SMS/OTP provider is needed.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM_NAME=SetuMoolya Platform

# Temporary passwords expire after this many hours (1–168).
TEMP_PASSWORD_HOURS=48

# One-time admin setup: configure these ONLY in the ignored .env file,
# then run npm run admin:create. Remove ADMIN_PASSWORD afterward.
ADMIN_EMAIL=admin-user@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=SetuMoolya Admin

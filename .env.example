# ==========================================
# SETUMOOLYA BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# Supabase Credentials (Get these from your Supabase Project Settings -> API)
# Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=your_supabase_project_url

# Supabase Anon Key (Public Key used for client auth requests)
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase Service Role Key (Secret Key used for privileged server-side operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

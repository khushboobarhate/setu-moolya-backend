# ==========================================
# SETUMOOLYA BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# Supabase (https://supabase.com/dashboard -> Project -> Settings -> API)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# JWT Secret (used for phone_verified_token signing)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Frontend Client URL (for CORS and login link in emails)
CLIENT_URL=http://localhost:3000
CLIENT_LOGIN_URL=http://localhost:3000/login

# Email Configuration (SMTP)
# Supports Gmail, SMTP2Go, Mailgun SMTP, SendGrid SMTP, etc.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM_NAME=SetuMoolya Platform

# System-generated Login Email Domain
# Approved users receive a login email like: username123456@setumoolya.com
LOGIN_EMAIL_DOMAIN=setumoolya.com

# SMS / OTP Configuration
# SMS_PROVIDER options: "twilio" | "msg91" | "dev" (dev = local testing only)
SMS_PROVIDER=dev

# OTP expiry time in minutes
OTP_EXPIRY_MINUTES=10

# --- Twilio (if SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# --- MSG91 OTP widget (if SMS_PROVIDER=msg91) ---
# Server-side AuthKey used only to validate the access token returned by the browser widget.
MSG91_AUTH_KEY=your_msg91_auth_key
# Configure the widgetId and tokenAuth from MSG91's OTP Widget settings in your frontend.
